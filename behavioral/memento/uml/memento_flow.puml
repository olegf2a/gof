@startuml memento_flow

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #f9f9f9
skinparam sequenceParticipantBorderColor #444444
skinparam sequenceLifeLineBorderColor #888888

participant "__main__"              as Main
participant "history : VersionHistory" as History
participant "editor : TextEditor"   as Editor
participant "snap : TextSnapshot"   as Snap

== Setup ==

Main   -> Editor  : <<create>> TextEditor()
Main   -> History : <<create>> VersionHistory()

== Save version 1 ==

Main   -> Editor  : write("First draft.")
Main   -> History : save(editor)
activate History
  History -> Editor : save()
  activate Editor
    Editor -> Snap  : <<create>> TextSnapshot("First draft.")
    Editor --> History : snap
  deactivate Editor
  History -> History : _history.append(snap)
deactivate History

== Save version 2 ==

Main   -> Editor  : write("Second draft.")
Main   -> History : save(editor)
activate History
  History -> Editor : save()
  activate Editor
    Editor -> Snap  : <<create>> TextSnapshot("Second draft.")
    Editor --> History : snap
  deactivate Editor
  History -> History : _history.append(snap)
deactivate History

== Save version 3 ==

Main   -> Editor  : write("Third draft.")
Main   -> History : save(editor)
activate History
  History -> Editor : save()
  activate Editor
    Editor -> Snap  : <<create>> TextSnapshot("Third draft.")
    Editor --> History : snap
  deactivate Editor
  History -> History : _history.append(snap)
deactivate History

== Restore version 0 ==

Main   -> History : restore(editor, 0)
activate History
  History -> History : snap = _history[0]
  History -> Editor  : restore(snap)
  activate Editor
    Editor -> Snap  : get_content()
    Snap   --> Editor : "First draft."
    Editor -> Editor : _content = "First draft."
  deactivate Editor
deactivate History

== Restore version 1 ==

Main   -> History : restore(editor, 1)
activate History
  History -> History : snap = _history[1]
  History -> Editor  : restore(snap)
  activate Editor
    Editor -> Snap  : get_content()
    Snap   --> Editor : "Second draft."
    Editor -> Editor : _content = "Second draft."
  deactivate Editor
deactivate History

== Invalid version ==

Main   -> History : restore(editor, 99)
activate History
  History -> History : _history[99]  raises IndexError
  History --> Main   : raises RuntimeError("Version 99 does not exist")
deactivate History

@enduml
