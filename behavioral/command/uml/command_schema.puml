@startuml command_schema

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam ArrowColor #444444
skinparam ClassBorderColor #444444
skinparam PackageBackgroundColor #f9f9f9

package "Client" {
  class "__main__" as Main {
    + demo() : None
  }
}

package "Invoker" {
  abstract class Invoker {
    + run(action: str) : None  {abstract}
    + undo()           : None  {abstract}
  }

  class Order {
    - _receiver : Receiver
    - _history  : list[Command]
    + run(action: str) : None
    + undo()           : None
    + describe()       : str
  }

  Invoker <|-- Order
}

package "Command" {
  abstract class Command {
    + execute() : None  {abstract}
    + undo()    : None  {abstract}
  }

  class AddTopping {
    - _receiver : Receiver
    - _context  : str
    + execute() : None
    + undo()    : None
  }

  Command <|-- AddTopping
}

package "Receiver" {
  abstract class Receiver {
    + action(context: str)         : None  {abstract}
    + reverse_action(context: str) : None  {abstract}
    + describe()                   : str   {abstract}
  }

  class Pizza {
    - _toppings : list[str]
    + action(context: str)         : None
    + reverse_action(context: str) : None
    + get_toppings()               : list[str]
    + describe()                   : str
  }

  Receiver <|-- Pizza
}

Main        -->  Order       : creates & drives
Main        -->  Pizza       : creates
Order       *--  Command     : stores history
Order       o--> Receiver    : holds
AddTopping  o--> Receiver    : calls action on

note right of Order
  run() creates a Command,
  executes it, appends to history.
  undo() pops and reverses last.
end note

note right of Command
  Encapsulates one topping action.
  execute() → action()
  undo()    → reverse_action()
end note

legend right
  <|--  inheritance
  *--   composition (owns)
  o-->  aggregation (references)
  -->   association
end legend

@enduml
